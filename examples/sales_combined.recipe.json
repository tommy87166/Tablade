{
  "tablade_recipe": "1.0",
  "name": "門市銷售合計（附加＋結合）",
  "description": "範例：文字匯出檔與 Excel 各自整理後接成一份（附加），再到品項對照表查出類別（結合）。先執行 uv run python scripts/gen_fixtures.py examples/data 產生假資料",
  "stages": [
    {
      "name": "品項對照",
      "input": { "files": ["data/品項對照.csv"], "reader": "csv", "encoding": "auto" },
      "steps": [
        { "id": "a1", "type": "trim_clean", "columns": ["品號", "類別"] }
      ]
    },
    {
      "name": "文字明細",
      "input": { "files": ["data/明細_*.csv"], "reader": "text_lines", "encoding": "auto" },
      "steps": [
        { "id": "t1", "type": "remove_top_rows", "n": 2 },
        { "id": "t2", "type": "remove_bottom_rows", "n": 1 },
        { "id": "t3", "type": "remove_blank_rows" },
        { "id": "t4", "type": "split_delimited", "column": "line", "delimiter": ",", "quote": "\"",
          "columns": ["欄1", "欄2", "欄3", "欄4", "欄5", "欄6"] },
        { "id": "t5", "type": "promote_headers", "names": ["日期", "門市", "品號", "品名", "備註", "金額"] },
        { "id": "t6", "type": "fill_down", "columns": ["門市"] },
        { "id": "t7", "type": "filter",
          "conditions": [{ "column": "金額", "op": "starts_with", "value": "(" }], "keep": "non_matching" },
        { "id": "t8", "type": "select_columns", "columns": ["日期", "門市", "品號", "品名", "金額"] },
        { "id": "t9", "type": "parse_date", "columns": ["日期"], "pattern": "slash", "calendar": "roc" },
        { "id": "t10", "type": "parse_number", "columns": ["金額"], "kind": "integer" }
      ]
    },
    {
      "name": "Excel明細",
      "input": { "files": ["data/明細.xlsx"], "reader": "excel", "sheet": "明細" },
      "steps": [
        { "id": "x1", "type": "remove_top_rows", "n": 3 },
        { "id": "x2", "type": "promote_headers", "names": ["日期", "門市", "品號", "品名", "數量", "金額"] },
        { "id": "x3", "type": "parse_date", "columns": ["日期"], "pattern": "dash", "calendar": "ad" },
        { "id": "x4", "type": "parse_number", "columns": ["數量", "金額"], "kind": "integer" }
      ]
    },
    {
      "name": "預設階段",
      "input": { "reader": "stages", "stages": ["文字明細", "Excel明細"] },
      "steps": [
        { "id": "m1", "type": "merge_files", "name": "全部明細" },
        { "id": "j1", "type": "join", "right": "品項對照",
          "on": [{ "left": "品號", "right": "品號" }], "columns": ["類別"] }
      ]
    }
  ],
  "output": { "format": "parquet", "keep_system_columns": true }
}
